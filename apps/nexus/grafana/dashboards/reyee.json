      "transparent": true,
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "#64D2FF"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#30D158",
                "value": null
